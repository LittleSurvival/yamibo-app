memberWork:
SELECT workId FROM SmartComicMember WHERE owner = ? AND fid = ? AND tid = ?;

workById:
SELECT * FROM SmartComicWork WHERE id = ? AND owner = ?;

works:
SELECT * FROM SmartComicWork WHERE owner = ? ORDER BY lastReadAt DESC, id DESC;

members:
SELECT summary FROM SmartComicMember WHERE workId = ? AND ordinal >= 0 ORDER BY ordinal, tid;

downloadedReaderChapters:
SELECT currentChapter.summary, currentChapter.ordinal, resumeChapter.tid AS resumeTid, resumeChapter.summary AS resumeSummary
FROM SmartComicMember AS currentChapter
JOIN SmartComicWork AS work ON work.id = currentChapter.workId AND work.owner = currentChapter.owner
LEFT JOIN SmartComicMember AS resumeChapter ON resumeChapter.owner = currentChapter.owner
    AND resumeChapter.fid = currentChapter.fid AND resumeChapter.tid = work.lastTid
    AND resumeChapter.workId = work.id AND resumeChapter.ordinal >= 0 AND resumeChapter.tid != currentChapter.tid
WHERE currentChapter.owner = ? AND currentChapter.fid = ? AND currentChapter.tid = ?;

activeMemberTids:
SELECT tid FROM SmartComicMember WHERE workId = ? AND ordinal >= 0;

retireMembers:
UPDATE SmartComicMember SET ordinal = -1 WHERE workId = ? AND ordinal >= 0;

createWork:
INSERT INTO SmartComicWork(owner,fid,title) VALUES (?,?,?);

newId:
SELECT last_insert_rowid();

saveMember:
INSERT OR REPLACE INTO SmartComicMember(owner,fid,tid,workId,summary,ordinal) VALUES (?,?,?,?,?,?);

updateTitle:
UPDATE SmartComicWork SET title = ?, completeAt = COALESCE(?,completeAt) WHERE id = ? AND owner = ?;

visit:
UPDATE SmartComicWork SET lastTid = ?, lastReadAt = :at WHERE id = ? AND owner = ?
AND (lastReadAt IS NULL OR lastReadAt <= :at);

memberOwners:
SELECT tid,workId FROM SmartComicMember WHERE owner = ? AND fid = ? AND tid IN ?;

lastOrdinal:
SELECT ordinal FROM SmartComicMember WHERE workId = ? ORDER BY ordinal DESC LIMIT 1;

progress:
SELECT * FROM SmartComicProgress WHERE owner = ? AND fid = ? AND tid IN ?;

saveProgress:
INSERT OR REPLACE INTO SmartComicProgress(owner, fid, tid, page, imageIndex, imageCount, finished, observedAt)
VALUES (?,?,?,?,?,?,?,?);

setUnread:
UPDATE SmartComicProgress SET finished = 0, observedAt = :at
WHERE owner = ? AND fid = ? AND tid = ? AND observedAt <= :at;
