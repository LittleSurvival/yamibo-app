getBySession:
SELECT * FROM AppSyncRetainedJournal WHERE sessionId = ?;

getForAccount:
SELECT sessionId FROM AppSyncRetainedJournal WHERE accountBinding = ? ORDER BY completedAtEpochMillis, sessionId;

getUnchecked:
SELECT sessionId FROM AppSyncRetainedJournal WHERE accountBinding = ?
AND (lastCheckedCheckpointFingerprint IS NULL OR lastCheckedCheckpointFingerprint != ?)
ORDER BY completedAtEpochMillis, sessionId LIMIT ?;

markChecked:
UPDATE AppSyncRetainedJournal SET lastCheckedCheckpointFingerprint = ? WHERE sessionId = ?;

deleteCovered:
DELETE FROM AppSyncRetainedJournal WHERE sessionId = ?;

preserveCompleted:
INSERT INTO AppSyncRetainedJournal(sessionId, accountBinding, generationId, payloadIdentity,
canonicalEnvelope, envelopeFingerprint, rootBlogId, rootFingerprint, indexIntentBody, indexIntentSha256,
verifiedIndexBlogId, verifiedIndexFingerprint, indexVerifiedAtEpochMillis, completedAtEpochMillis)
SELECT s.sessionId, s.accountBinding, s.generationId, p.payloadIdentity, p.canonicalEnvelope,
p.envelopeFingerprint, s.rootBlogId, s.rootFingerprint, p.indexIntentBody, p.indexIntentSha256,
p.verifiedIndexBlogId, p.verifiedIndexFingerprint, p.indexVerifiedAtEpochMillis, s.completedAtEpochMillis
FROM AppSyncRecoverySession s JOIN AppSyncRecoveryPayload p USING (sessionId)
WHERE s.sessionId = ? AND s.phase = 'COMPLETED' AND s.mode = 'SEGMENTED_JOURNAL'
AND s.indexCommitted = 1 AND p.transportVersion = 3;
