insertEvent:
INSERT INTO FavoriteUpdateEvent(
    targetType, targetId, authorId, fid, forumName, title, latestPostTitle, mode, summary, detailIds,
    coverUrl, detectedAt, readAt, dismissedAt, ambiguous
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertBySyncId:
INSERT OR IGNORE INTO FavoriteUpdateEvent(
    targetType, targetId, authorId, fid, forumName, title, latestPostTitle, mode, summary, detailIds,
    coverUrl, detectedAt, readAt, dismissedAt, ambiguous, syncId, sourceFingerprint, sourceDiscriminator
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateBySyncId:
UPDATE FavoriteUpdateEvent
SET fid = ?,
    forumName = ?,
    title = ?,
    latestPostTitle = ?,
    summary = ?,
    coverUrl = ?,
    readAt = ?,
    dismissedAt = ?
WHERE syncId = ?;

setIdentity:
UPDATE FavoriteUpdateEvent
SET syncId = ?, sourceFingerprint = ?, sourceDiscriminator = ?
WHERE id = ?;

getBySyncId:
SELECT * FROM FavoriteUpdateEvent
WHERE syncId = ?;

getById:
SELECT * FROM FavoriteUpdateEvent
WHERE id = ?;

getActive:
SELECT * FROM FavoriteUpdateEvent
WHERE dismissedAt IS NULL
ORDER BY detectedAt DESC, id DESC;

getAll:
SELECT * FROM FavoriteUpdateEvent
ORDER BY detectedAt DESC, id DESC;

countActive:
SELECT COUNT(*) FROM FavoriteUpdateEvent
WHERE dismissedAt IS NULL;

markRead:
UPDATE FavoriteUpdateEvent
SET readAt = ?
WHERE id = ?;

dismiss:
UPDATE FavoriteUpdateEvent
SET dismissedAt = ?
WHERE id = ?;

dismissAll:
UPDATE FavoriteUpdateEvent
SET dismissedAt = ?
WHERE dismissedAt IS NULL;

deleteBySyncId:
DELETE FROM FavoriteUpdateEvent
WHERE syncId = ?;

deleteById:
DELETE FROM FavoriteUpdateEvent
WHERE id = ?;

deleteForTarget:
DELETE FROM FavoriteUpdateEvent
WHERE targetType = ? AND targetId = ? AND authorId = ?;

deleteAll:
DELETE FROM FavoriteUpdateEvent;

