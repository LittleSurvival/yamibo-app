upsert:
INSERT OR REPLACE INTO ImageReadingHistory(
    postId, threadId, pageIndex, totalPages,
    firstVisibleItemIndex, firstVisibleItemOffset,
    lastVisitTime
) VALUES (?, ?, ?, ?, ?, ?, ?);

getAllWithAnchors:
SELECT h.*, a.floorPid, a.sourceId, a.occurrence, a.page AS forumPage, a.authorId AS scopeAuthor FROM ImageReadingHistory AS h
LEFT JOIN ReaderImageAnchor AS a ON a.historyPostId = h.postId AND a.observedAt = h.lastVisitTime
ORDER BY h.lastVisitTime DESC;

getByPostId:
SELECT * FROM ImageReadingHistory WHERE postId = ?;

getAll:
SELECT * FROM ImageReadingHistory
ORDER BY lastVisitTime DESC;

deleteByPostId:
DELETE FROM ImageReadingHistory WHERE postId = ?;

deleteByThreadId:
DELETE FROM ImageReadingHistory WHERE threadId = ?;

deleteAll:
DELETE FROM ImageReadingHistory;

trimToLatest:
DELETE FROM ImageReadingHistory
WHERE postId IN (
    SELECT postId
    FROM ImageReadingHistory
    ORDER BY lastVisitTime DESC
    LIMIT -1 OFFSET ?
);

latestInThread:
SELECT * FROM ImageReadingHistory WHERE threadId = :threadId ORDER BY lastVisitTime DESC, postId LIMIT 1;

getAnchor:
SELECT * FROM ReaderImageAnchor WHERE historyPostId = :postId AND observedAt = :observedAt;

saveAnchor:
INSERT OR REPLACE INTO ReaderImageAnchor(historyPostId, observedAt, floorPid, sourceId, occurrence, page, authorId)
VALUES (?, ?, ?, ?, ?, ?, ?);

clearAnchorAt:
DELETE FROM ReaderImageAnchor WHERE historyPostId = ? AND observedAt = ?;
